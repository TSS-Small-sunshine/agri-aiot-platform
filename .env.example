# ============================================================
# 智慧农业 AIoT 平台 —— 环境变量样例（全量，共 25 个）
# 用法：cp .env.example .env  然后按需修改
# 契约来源：docs/CONTRACT.md 第 2 节（修订 v1.2，变量名不可增删改）
# 注意：本文件必须与契约第 2 节的变量集合"不多不少"完全一致
# ============================================================

# ---------- 应用 ----------
# 后端 HTTP 监听端口；compose 里映射为 8000:8000，改这里要同步改 compose 端口映射
APP_PORT=8000
# 版本号，会出现在 /api/health 响应里
APP_VERSION=2.0.0

# ---------- 数据与存储 ----------
# SQLite 数据库文件路径。容器内必须指向挂载卷 /data，否则重启后数据丢失
DB_PATH=/data/agri.db
# 数据目录（数据库、日志等）。容器内即 agri-data 卷的挂载点
DATA_DIR=/data

# ---------- MQTT ----------
# broker 主机名。容器内用 compose 服务名 mosquitto；本机裸机开发改成 127.0.0.1
MQTT_HOST=mosquitto
# broker 端口，mosquitto 默认 1883
MQTT_PORT=1883
# 订阅主题通配符，格式 agri/telemetry/{plot_code}/{device_code}
MQTT_TOPIC=agri/telemetry/+/+
# 设备离线判定秒数：last_seen 距今超过该值即标记为 offline
DEVICE_OFFLINE_SECONDS=30

# ---------- 数据保留 ----------
# 遥测数据保留天数，超过的历史数据会被清理
TELEMETRY_RETENTION_DAYS=7
# 历史查询接口 hours 参数上限（168 小时 = 7 天）
HISTORY_HOURS_MAX=168

# ---------- 跨域 ----------
# 允许的跨域来源。生产环境前后端同源托管，保持 * 即可；需要收紧时填具体域名，逗号分隔
CORS_ORIGINS=*

# ---------- 大模型（OpenAI 兼容接口）----------
# 兼容 OpenAI 协议的 API 地址，例如 https://dashscope.aliyuncs.com/compatible-mode/v1
# 留空 = 不接大模型，AI 接口自动走 Mock 降级（degraded=true），演示流程依然完整
OPENAI_BASE_URL=
# API Key。留空同样触发 Mock 降级，不会报错
OPENAI_API_KEY=
# 默认模型名。留空则自动发现：有 Key 时取 {OPENAI_BASE_URL}/models 的第一个；无 Key 时为 mock-agronomist
OPENAI_MODEL=
# 单次大模型调用超时秒数，超时即降级到 Mock，避免大屏卡死
OPENAI_TIMEOUT_SECONDS=20
# 大模型调用失败重试次数，1 表示失败后再试 1 次
OPENAI_MAX_RETRIES=1
# /api/ai/history 返回条数上限
AI_HISTORY_LIMIT=50

# ---------- 模拟器 ----------
# 模拟器上报间隔秒数，前端轮询同为 5 秒，保持一致观感最好
SIM_INTERVAL_SECONDS=5
# 模拟设备清单，逗号分隔；必须与契约第 3 节设备清单一致
SIM_DEVICES=FJ-CITRUS-A01,FJ-CITRUS-A02,FJ-CITRUS-B01,FJ-CITRUS-B02
# 每次采样注入越界值的概率（0~1），用于演示告警链路；设 0 可关闭随机告警
SIM_BAD_PROBABILITY=0.12
# 同一 device_code + metric + level 的告警冷却秒数，防止 5s 高频上报把告警表刷爆
ALERT_COOLDOWN_SECONDS=300

# ---------- V2.0 运行时配置中心 ----------
# 配置中心落盘路径。用户在大屏齿轮弹窗里填的 base_url / api_key / model 存这里，
# 优先级**高于环境变量**（runtime_config.json > 环境变量 > 内置 Mock），改完即热生效、无需重启容器
# 该文件含明文 API Key，已被 .gitignore 显式忽略，绝不可入库
RUNTIME_CONFIG_PATH=/data/runtime_config.json

# ---------- V2.0 推演与指令闭环 ----------
# 单次推演调用大模型的超时秒数；推演 prompt 比农技问答长，故比 OPENAI_TIMEOUT_SECONDS（20）宽
REASONING_TIMEOUT_SECONDS=45
# 指令下发后等待模拟器回执的秒数，超时把该条指令标记为 timeout
COMMAND_ACK_TIMEOUT_SECONDS=30

# ---------- V2.0 气象上报（模拟器）----------
# 模拟器上报气象数据的间隔秒数，与 5s 遥测解耦（气象变化慢，无需高频）
WEATHER_INTERVAL_SECONDS=30
